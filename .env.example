# ================= 基础网络配置 =================
PORT=8300
PUBLIC_URL=https://your-domain.com

# ================= 业务与资金配置 (管理者自由调节) =================
# 每个新用户注册分配的初始虚拟资金 (USDT)，默认 1,000,000
INIT_CAPITAL=1000000.0

# 永续合约最高允许杠杆 (例如 100 或 400，默认 400)
MAX_LEV=400

# 单用户同时持仓上限与未成交挂单上限 (默认各 20 个)
MAX_POS=20
MAX_OPEN=20

# 交易手续费率 (以小数表示，如 0.001 代表 0.1%)
# 现货手续费 (Maker / Taker)
SPOT_MAKER=0.0008
SPOT_TAKER=0.001
# 永续合约手续费 (Maker / Taker)
SWAP_MAKER=0.0002
SWAP_TAKER=0.0005

# 最小单笔下单金额 (USDT)
MIN_NOTIONAL=1.0

# 行情刷新间隔与排行榜计算周期 (秒)
TICK_INTERVAL=1.5
LB_INTERVAL=30

# ================= 社区账号登录集成 (按需配置) =================
# 1. Linux.do Connect OAuth 凭据
# 在 https://connect.linux.do/ 创建应用，回调填 https://your-domain.com/api/auth/callback
LD_CLIENT_ID=
LD_CLIENT_SECRET=
# 允许登录的最低信任等级 (Trust Level，1 代表至少 TL1 活跃用户)
LD_MIN_TL=1

# 2. NodeLoc OAuth 凭据 (可选)
# 回调填 https://your-domain.com/api/auth/nodeloc/callback
NL_CLIENT_ID=
NL_CLIENT_SECRET=
NL_MIN_TL=0

# ================= 存储路径配置 (可选，默认优先环境变量) =================
# SIM_DATA=./data
# SIM_WWW_DATA=./www/data
